##########################################
## macOS-specific                       ##
##########################################

# Get Brew 'gnubin'/'gnuman' PATHs to prefer GNU versions of commands
BREW_PREFIX=${BREW_PREFIX:-$(brew --prefix)}
shopt -s nullglob
BREW_GNUPATHS=("${BREW_PREFIX}"/opt/*/libexec/gnubin)
BREW_MANPATHS=("${BREW_PREFIX}"/opt/*/libexec/gnuman)
shopt -u nullglob

IFS=':'
PATH="${HOME}/.local/bin:${PATH}"
PATH="${BREW_PREFIX}/bin:${BREW_PREFIX}/sbin:${PATH}"
PATH="${BREW_GNUPATHS[*]}:${PATH}"
MANPATH="${BREW_MANPATHS[*]}:${MANPATH}"
unset IFS
export MANPATH

PATH+=":/Applications/iTerm.app/Contents/Resources/utilities"
PATH+=":/Applications/Sublime Text.app/Contents/SharedSupport/bin"
PATH+=":/opt/homebrew/opt/openjdk/bin"
PATH+=":/Applications/BetterTouchTool.app/Contents/SharedSupport/bin"
